[Unit]
Description=Korea CRM PostgreSQL backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=koreacrm
Group=koreacrm
WorkingDirectory=/opt/koreacrm
EnvironmentFile=/etc/koreacrm/backup.env
ExecStart=/usr/bin/node /opt/koreacrm/tools/postgres-backup.mjs backup
UMask=0077
