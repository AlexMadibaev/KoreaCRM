{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Korea CRM POS",
  "version": "0.2.12",
  "identifier": "com.koreacrm.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "corepack pnpm dev",
    "beforeBuildCommand": "corepack pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Korea CRM POS",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFERUEwMUJCMzU2NUU4MTkKUldRWjZHVTF1d0hxSGViNU90ci9ubW1nMzFRWXl2dkZJanBiUlM3aU5LZENzTGpaZFVxUFRMc0UK",
      "endpoints": [
        "https://github.com/AlexMadibaev/KoreaCRM/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
